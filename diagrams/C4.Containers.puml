@startuml
title Теплый дом. Диаграмма контейнеров

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(user, "Пользователь", "Пользователь системы умный дом")
Person(admin, "Администратор", "Администратор системы умный дом")
System(SmartHouse, "система Умный дом", "Система управления отоплением домов и умными устройствами")

Container_Boundary(SmartHouse, "FitLife System") {
  Container(WebApp, "Web приложение", "react", "Панель управления устройствами")
  Container(WebAppAdmin, "Web приложение", "react", "Панель администратора")
  Container(GateWay, "API шлюз", "Go", "Маршрутизация запросов")
  Container(UserAccess, "Доступ пользователей", "Go", "Управление данных пользователей")
  ContainerDb(UserAccessDb, "Database Пользователи", "PostgreSQL", "Хранение данных пользователей")
  Container(DeviceRepository, "Реестр устройств", "Go", "Управление устройствами, их расположении и доступности для пользователя")
  ContainerDb(DeviceRepositoryDb, "Database устройства", "PostgreSQL", "Хранение информации об устройствах, их расположении")
  Container(Automatic, "Модуль автоматизации", "Go", "Управление устройствами по сценариям и графикам")
  ContainerDb(AutomaticDb, "База данных автоматизации", "PostgreSQL", "Хранение сценариев и графиков управления устройствами")
  Container(DeviceControl, "Управление устройствами", "Go", "Взаимодействие с устройствами")
  Container(Telemetry, "Модуль телеметрии", "Go", "Получение телеметрии датчиков и устройств")
  ContainerDb(DeviceDatabase, "Devices database", "PostgreSQL", "Хранение данных об устройствах, текущее состояние")
  ContainerDb(TelemetryDatabase, "База данных телеметрии", "PostgreSQL", "Временные ряды состояний датчиков и устройств")
}

System_Ext(PaidService, "Сервис оплаты", "")
System_Ext(SmartDevice, "Устройства", "Умные устройства, датчики и регуляторы отопления (экосистема партнеров)")


Rel(user, WebApp, "Управляет устройствами своего дома")
Rel(admin, WebAppAdmin,"Управляет пользователями и доступом к датчикам")

Rel(WebApp, GateWay, "Обработка запросов")
Rel(WebAppAdmin, GateWay, "Обработка запросов")

Rel(GateWay, UserAccess, "Авторизация, управление")
Rel(UserAccess, UserAccessDb, "Запись/чтение данных")
Rel(GateWay, Telemetry, "Получение отчетов и данных в реальном времени")
Rel(GateWay, Automatic, "Управление автоматизацией")
Rel(Automatic, AutomaticDb, "Запись/чтение данных")
Rel(GateWay, DeviceRepository, "Получение доступных устройств, регистрация новых")
Rel(DeviceRepository, DeviceRepositoryDb, "Запись/чтение данных")
Rel(DeviceRepository, DeviceControl, "Регистрация устройств")
Rel(Automatic, DeviceControl, "Управление и получение данных")
Rel(DeviceControl,DeviceDatabase,"Получение информации об устройствах")
Rel(Telemetry,TelemetryDatabase,"Запись/чтение данных")
Rel(Telemetry, DeviceControl, "Показания датчиков, телеметрия")
Rel(DeviceControl,SmartDevice,"Взаимодействие с экосистемой")
Rel(UserAccess, PaidService, "Оплата подписки")
@enduml