@startuml
title Теплый дом. Модуль оповещений. Диаграмма компонентов

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml


Container_Boundary(SmartHouse, "Система Умный дом") {
  Container(GateWay, "API шлюз", "Go", "Маршрутизация запросов")
  Container(UserAccess, "Управление пользователями", "Go", "Управление данных пользователей")
  Container(Notification, "Модуль оповещений", "Go", "Формирование сообщений по определенным событиям")
  ContainerDb(NotificationDb, "База данных оповещений", "Go", "Хранение условий формирования оповещений")
  Container(Telemetry, "Модуль телеметрии", "Go", "Обработка и хранение телеметрии датчиков и устройств")
}

System_Ext(Messengers, "Мессендеры", "Доставка событий")

Container(Notification, "Модуль оповещений", "Go") {
  Component(ManageController, "API Управление оповещениями", "CRUD операции")
  Component(ServiceLayer, "Слой бизнес логики", "Обработка запросов")
  Component(Observer, "Наблюдатель", "Контроллирует заданные уведомления")
  Component(MessageGenerator, "Генератор сообщений", "формирует оповещения")
  Component(MessageSender, "Отправитель сообщений", "Отправляет оповещения")
  Component(RepositoryLayer, "Repository Layer", "Доступ к БД")
}

Rel(GateWay, ManageController, "Управление оповещениями")
Rel(Observer, Telemetry, "Определение формирования событий")
Rel(MessageSender, Messengers, "Доставка событий")
Rel(MessageSender, UserAccess, "Получение контактов для отправления событий")
Rel(ManageController, ServiceLayer, "Получение списка устройств")
Rel(ServiceLayer, RepositoryLayer, "Получение списка устройств")
Rel(RepositoryLayer, NotificationDb, "Получение контактов для отправления событий")
Rel(Observer, ServiceLayer, "Получение списка оповещений")
Rel(Observer, MessageGenerator, "Отправляет команду для формирования оповещений")
Rel(MessageGenerator, MessageSender, "Отправляет команду для формирования оповещений")
@enduml