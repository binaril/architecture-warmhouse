@startuml
title Теплый дом. Реестр устройств. Диаграмма компонентов

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml


Container_Boundary(SmartHouse, "Система Умный дом") {
  Container(GateWay, "API шлюз", "Go", "Маршрутизация запросов")
  Container(DeviceRepository, "Реестр устройств", "Go", "Управление устройствами, их расположении и доступности для пользователя")
  ContainerDb(DeviceRepositoryDb, "Database устройства", "PostgreSQL", "Хранение информации об устройствах, их расположении")
  Container(Automatic, "Модуль управления и автоматизацией", "Go", "Управление устройствами по сценариям и графикам")
  Container(DeviceControl, "Взаимодействие устройствами", "Go", "Взаимодействие с устройствами")   
}

Container(DeviceRepository, "Реестр устройств", "Go") {
  Component(ApiHandler, "API", "Обработка запросов")
  Component(PollingCircle, "UserController", "Manages user profiles")
  Component(ScheduleController, "ScheduleController", "Manages schedules")
  Component(PaymentController, "PaymentController", "Handles payment processing")
  Component(Aggragator, "Service Layer", "Бизнес логика")
  Component(RepositoryLayer, "Repository Layer", "Доступ к БД")
}

Rel(GateWay, DeviceRepository, "Получение доступных устройств, регистрация новых")
Rel(Automatic, DeviceRepository, "Получение списка устройств управления")
Rel(DeviceControl, DeviceRepository, "Получение списка устройств")
Rel(DeviceRepository, DeviceRepositoryDb, "Запись/чтение данных")
@enduml